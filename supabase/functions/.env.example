# Variables de las Edge Functions. Copia a `supabase/functions/.env` (git-ignored)
# y ajusta para tu entorno. En LOCAL los valores por defecto envían a Mailpit.
#
#   cp supabase/functions/.env.example supabase/functions/.env

# Secreto que exige process-reminders en la cabecera x-reminder-secret.
# DEBE coincidir con private.reminder_runtime.invoke_secret (ver seed.sql en local).
REMINDER_INVOKE_SECRET=local-dev-reminder-secret

# SMTP de envío. Local = Mailpit (sin auth). Producción: pon el relay del proveedor
# (p. ej. Resend SMTP) y sus credenciales.
SMTP_HOST=host.docker.internal
SMTP_PORT=54325
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Registro Gym <no-reply@registro-gym.test>
